# Example environment variables for local development
# Copy to .env and customize; .env is ignored by git.

# Phantom secret for dev. Replace in your local .env with a real random value if needed.
SECRET_KEY_BASE=dev_change_me_secret_key_base

# Optional: database URL for production or Docker setups
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE

# ---- Compose mode ---------------------------------------------------------
# Which profile `docker compose` activates. Compose reads this file in EVERY
# subcommand (up, stop, down), so .env must exist for any of them to work.
#   standalone   this repo starts its own Postgres on :5432 (see docker-compose.yml)
#   poli-runner  injected by poli-runner; the bundled db stays down and the connection
#                vars come from the runner (see poli-runner.yml)
COMPOSE_PROFILES=standalone

# Where the app connects, in standalone mode. config/dev.exs reads these (DATABASE_URL
# is only used by config/runtime.exs in prod). They belong here and NOT in dev.env:
# docker-compose.yml declares them as passthrough vars, and a passthrough overrides
# env_file values — blanking them when nothing supplies a value.
DATABASE_HOST=db
DATABASE_PORT=5432
