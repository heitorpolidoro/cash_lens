# Example environment variables for local development
# Copy to .env and customize; .env is ignored by git.

# Phantom secret for dev. Replace in your local .env with a real random value if needed.
SECRET_KEY_BASE=dev_change_me_secret_key_base

# Production database (docs/security.md). Two roles: the app connects as the
# unprivileged `cash_lens_app` (DATABASE_URL); migrations and backups use the
# owner (MIGRATION_DATABASE_URL). TLS is always verified; DATABASE_CA_CERT_PATH
# points at the CA PEM, otherwise the system store is used.
# DATABASE_URL=ecto://cash_lens_app:PASS@HOST/DATABASE
# MIGRATION_DATABASE_URL=ecto://OWNER:PASS@HOST/DATABASE
# DATABASE_CA_CERT_PATH=/etc/ssl/certs/db-ca.pem

# Dev/test: the owner is DATABASE_USER/DATABASE_PASSWORD (default postgres), the
# runtime role is DATABASE_APP_USER/DATABASE_APP_PASSWORD (default cash_lens_app).

# Encrypted backups (scripts/backup.sh): the age PUBLIC key only.
# BACKUP_AGE_RECIPIENT=age1...
