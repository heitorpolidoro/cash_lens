#!/usr/bin/env bash
# Run the app natively (no app container), against this repo's own Postgres.
#
#   ./run         start the Phoenix server
#   ./run --iex   start it inside an IEx shell
set -euo pipefail
cd "$(dirname "$0")"

iex_mode=false
case "${1:-}" in
  --iex)  iex_mode=true ;;
  "")     ;;
  *)      echo "usage: ./run [--iex]" >&2; exit 2 ;;
esac

# Capture caller overrides first: .env below targets the compose network ("db"),
# which is not reachable from the host.
_host="${DATABASE_HOST:-}"; _port="${DATABASE_PORT:-}"; _name="${DATABASE_NAME:-}"

echo "🚀 Starting Postgres (docker compose service 'db')..."
docker compose up -d --wait db
echo "✅ Postgres is ready!"

if [ -f .env ]; then set -a; . ./.env; set +a; fi

export DATABASE_HOST="${_host:-localhost}"
export DATABASE_PORT="${_port:-5432}"
export DATABASE_NAME="${_name:-cash_lens}"
export PORT="${PORT:-4444}"

echo "💻 Starting Phoenix application locally..."
if [ "$iex_mode" = true ]; then
  exec iex -S mix phx.server
else
  exec mix phx.server
fi
