#!/usr/bin/env bash
# Run the app natively on the host, against the same database the compose stack
# uses.
#
#   ./run         start the Phoenix server
#   ./run --iex   start it inside an IEx shell
#
# Why this script exists at all: docker-compose.yml deliberately does not publish
# Postgres to the host, so nothing outside the compose network can reach it. A
# native `mix phx.server` therefore has no database — unless something publishes
# the port for as long as the native process needs it. That is this script's job.
#
# It starts its own Postgres container on the SAME named volume the compose `db`
# service uses, so the data is identical either way: what you import through the
# container is there when you run natively, and vice versa. The port is published
# only while this script runs, and the container is removed when it exits.
#
# Two Postgres processes must never open the same data directory at once, so the
# compose `db` is stopped first, and the script then REFUSES TO START if any
# running container still holds the volume.
#
# That check is not belt-and-braces; it is the only real protection. Postgres's
# own postmaster.pid lock does not work here: the lock stores a PID, and each
# container has its own PID namespace, so a second Postgres reads the lock, looks
# for that PID among its own processes, does not find it, concludes the lock is
# stale, and starts anyway. Two postmasters then recycle each other's WAL
# segments while both write pg_control, and the cluster is corrupted — it comes
# back as `PANIC: could not locate a valid checkpoint record`, because the
# segment pg_control points at has been recycled out from under it. That is not
# hypothetical; it happened on 2026-09-22 and cost a pg_resetwal recovery.
#
# The remaining hazard this script CANNOT close: `docker compose up -d` started
# from another terminal WHILE this script is running starts the compose `db` on
# the same volume, and nothing here will see it. Do not do that. To run the
# container test suite, stop this script first.
set -euo pipefail
cd "$(dirname "$0")"

iex_mode=false
case "${1:-}" in
  --iex)  iex_mode=true ;;
  "")     ;;
  *)      echo "usage: ./run [--iex]" >&2; exit 2 ;;
esac

PG_IMAGE="postgres:16-alpine"
PG_CONTAINER="cash_lens-db-native"
PG_VOLUME="$(docker compose config --format json \
  | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["name"] + "_cash_lens_pgdata")')"
HOST_PORT="${DATABASE_PORT:-5432}"

_cleaned=false
_pg_started=false
cleanup() {
  # INT/TERM run this and then fall through to EXIT, so guard against running twice.
  [ "$_cleaned" = true ] && return
  _cleaned=true
  # Bailing out before the container was ever started must not claim to stop it.
  if [ "$_pg_started" = true ]; then
    echo "🧹 Stopping the native Postgres container..."
    docker rm -f "$PG_CONTAINER" >/dev/null 2>&1 || true
  fi
  echo "   The compose stack is still down. Bring it back with: docker compose up -d"
}
# HUP matters as much as INT and TERM: closing the terminal sends it, and an
# untrapped HUP kills the script outright without running the EXIT trap. That is
# how a run survives as an orphan child of init with its Postgres still holding
# the volume — the exact state that let a second postmaster corrupt the cluster.
trap cleanup EXIT INT TERM HUP

# The compose app would clash on port 4444 with the native server, and the
# compose db would clash on the data directory. Both stop for the duration.
echo "⏹  Stopping the compose app and db (they share the port and the volume)..."
docker compose stop app db >/dev/null 2>&1 || true

# A leftover container from a killed run would hold both the port and the volume.
docker rm -f "$PG_CONTAINER" >/dev/null 2>&1 || true

# Nothing else may hold the volume. `docker ps --filter volume=` asks the daemon
# which running containers mount it, which is the one question that is actually
# authoritative here — unlike postmaster.pid, it does not depend on PID
# namespaces, and it catches a container this script does not know about.
holders="$(docker ps --filter "volume=$PG_VOLUME" --format '{{.Names}}')"
if [ -n "$holders" ]; then
  echo "❌ Refusing to start: these running containers still hold $PG_VOLUME:" >&2
  echo "$holders" | sed 's/^/     /' >&2
  echo >&2
  echo "   Starting a second Postgres on that volume corrupts the cluster." >&2
  echo "   Stop them first, then run this script again." >&2
  exit 1
fi

echo "🐘 Starting Postgres on volume $PG_VOLUME, published at localhost:$HOST_PORT..."
# Deliberately not `--rm`: a container that exits on its own would be removed
# instantly, and the failure branch below would have nothing left to read logs
# from — it would report "No such container" instead of the PANIC that actually
# explains the failure. The cleanup trap removes the container instead.
docker run -d \
  --name "$PG_CONTAINER" \
  -e POSTGRES_USER=postgres \
  -e POSTGRES_PASSWORD=postgres \
  -e POSTGRES_DB=cash_lens \
  -p "$HOST_PORT:5432" \
  -v "$PG_VOLUME:/var/lib/postgresql/data" \
  --health-cmd 'pg_isready -U postgres' \
  --health-interval 2s \
  --health-timeout 5s \
  --health-retries 15 \
  "$PG_IMAGE" >/dev/null
_pg_started=true

echo -n "⏳ Waiting for Postgres to accept connections"
for _ in $(seq 1 30); do
  if [ "$(docker inspect -f '{{.State.Health.Status}}' "$PG_CONTAINER" 2>/dev/null)" = "healthy" ]; then
    echo " — ready."
    break
  fi
  # A container that has already exited will never become healthy. Waiting out
  # the full 30 seconds only delays the logs that say why it died.
  if [ "$(docker inspect -f '{{.State.Status}}' "$PG_CONTAINER" 2>/dev/null)" = "exited" ]; then
    break
  fi
  echo -n "."
  sleep 1
done

if [ "$(docker inspect -f '{{.State.Health.Status}}' "$PG_CONTAINER" 2>/dev/null)" != "healthy" ]; then
  echo
  echo "❌ Postgres did not become healthy. Its logs:" >&2
  docker logs --tail 30 "$PG_CONTAINER" >&2 || true
  exit 1
fi

# Capture caller overrides before sourcing .env, which targets the compose
# network host ("db") — not reachable from here.
_host="${DATABASE_HOST:-}"; _port="${DATABASE_PORT:-}"; _name="${DATABASE_NAME:-}"

if [ -f .env ]; then set -a; . ./.env; set +a; fi

export DATABASE_HOST="${_host:-localhost}"
export DATABASE_PORT="${_port:-$HOST_PORT}"
export DATABASE_NAME="${_name:-cash_lens}"
export PORT="${PORT:-4444}"

echo "💻 Starting Phoenix natively on port $PORT..."
# Deliberately not `exec`: exec replaces this shell, which would discard the
# EXIT trap and leave the Postgres container running after the server stops.
if [ "$iex_mode" = true ]; then
  iex -S mix phx.server
else
  mix phx.server
fi
