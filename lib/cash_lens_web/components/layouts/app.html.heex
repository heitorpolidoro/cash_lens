<% current_path = current_path(assigns) %>
<% today = Date.utc_today() %>
<% breadcrumb = nav_breadcrumb(current_path, today) %>
<div id="app-drawer" class="drawer lg:drawer-open bg-[#f8fafc]">
  <input id="my-drawer" type="checkbox" class="drawer-toggle" />

  <div class="drawer-content flex flex-col min-h-screen min-w-0 bg-[#f8fafc] text-slate-800">
    <!-- Topbar global -->
    <header class="h-16 bg-white border-b border-slate-200 sticky top-0 z-20 px-4 sm:px-8 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <label
          for="my-drawer"
          aria-label="Abrir menu"
          class="lg:hidden p-1.5 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition cursor-pointer"
        >
          <.icon name="hero-bars-3" class="size-5" />
        </label>

        <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 min-w-0">
          <%= if breadcrumb do %>
            <% {group_title, screen_title} = breadcrumb %>
            <span class="hidden sm:inline truncate">{group_title}</span>
            <.icon
              name="hero-chevron-right"
              class="hidden sm:inline-block size-3.5 text-slate-300"
            />
            <span class="text-slate-900 font-bold truncate">{screen_title}</span>
          <% else %>
            <span class="text-slate-900 font-bold truncate">CashLens</span>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 rounded-xl text-xs font-bold text-slate-700">
          <.icon name="hero-calendar-days" class="size-3.5 text-slate-500" />
          {month_name(today.month)} / {today.year}
        </div>

        <.link
          navigate={~p"/transactions/new"}
          class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-3 py-2 rounded-xl text-xs transition flex items-center gap-1.5"
          title="Nova Transação"
        >
          <.icon name="hero-plus" class="size-3.5" />
          <span class="hidden sm:inline">Nova Transação</span>
        </.link>

        <.link
          navigate={~p"/imports"}
          class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-xl text-xs transition shadow-sm flex items-center gap-1.5"
          title="Importar Extratos"
        >
          <.icon name="hero-arrow-up-tray" class="size-3.5" />
          <span class="hidden sm:inline">Importar Extratos</span>
        </.link>
      </div>
    </header>
    
<!-- Conteúdo da tela -->
    <main class="p-4 sm:p-8 flex-1 w-full max-w-7xl mx-auto">
      <.flash_group flash={@flash} />
      <%= if assigns[:inner_content] do %>
        {@inner_content}
      <% else %>
        {render_slot(@inner_block)}
      <% end %>
    </main>

    <footer class="px-8 py-4 text-[11px] text-slate-400 border-t border-slate-200 bg-white">
      CashLens © {today.year} — Controle Financeiro Inteligente
    </footer>
  </div>
  
<!-- Barra lateral -->
  <div class="drawer-side z-40">
    <label for="my-drawer" aria-label="Fechar menu" class="drawer-overlay"></label>

    <aside class="sidebar-container flex flex-col justify-between w-64 min-h-full h-screen bg-white border-r border-slate-200">
      <div class="min-h-0 flex flex-col">
        <div class="sidebar-header h-16 px-4 border-b border-slate-200 flex items-center justify-between gap-2 shrink-0">
          <a href="/" class="flex items-center gap-2.5 min-w-0" title="CashLens">
            <span class="w-8 h-8 shrink-0 rounded-xl bg-blue-600 flex items-center justify-center text-white font-black text-base">
              C
            </span>
            <span class="menu-label text-xl font-black text-slate-900 tracking-tight">
              CashLens
            </span>
          </a>
          <button
            id="sidebar-toggle"
            type="button"
            title="Recolher menu"
            aria-label="Recolher menu"
            aria-expanded="true"
            class="hidden lg:flex p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition"
          >
            <.icon name="hero-chevron-double-left" class="size-4" />
          </button>
        </div>

        <nav class="p-3 space-y-6 overflow-y-auto text-xs font-semibold">
          <div :for={group <- nav_groups(today)} class="space-y-1">
            <span class="section-title px-3 text-[10px] font-black uppercase tracking-wider text-slate-400 block">
              {group.title}
            </span>
            <a
              :for={item <- group.items}
              href={item.path}
              title={item.label}
              class={[
                "sidebar-link flex items-center gap-3 px-3 py-2 rounded-xl transition",
                if(nav_active?(item, current_path),
                  do: "bg-blue-50 text-blue-600 font-bold",
                  else: "text-slate-600 hover:text-blue-600 hover:bg-slate-50"
                )
              ]}
            >
              <.icon
                name={item.icon}
                class={[
                  "size-4 shrink-0",
                  if(nav_active?(item, current_path), do: "text-blue-600", else: "text-slate-400")
                ]}
              />
              <span class="menu-label truncate">{item.label}</span>
            </a>
          </div>
        </nav>
      </div>

      <div class="p-3 border-t border-slate-200 shrink-0">
        <div class="sidebar-user flex items-center gap-3 p-2 rounded-xl bg-slate-50 border border-slate-200/60">
          <span class="w-8 h-8 shrink-0 rounded-lg bg-blue-100 text-blue-700 font-bold text-xs flex items-center justify-center">
            HP
          </span>
          <div class="menu-label flex-1 min-w-0">
            <span class="text-xs font-bold text-slate-900 truncate block">Heitor Polidoro</span>
            <span class="text-[10px] text-emerald-600 font-extrabold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Banco Local Conectado
            </span>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .sidebar-container {
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Compact mode: icons only. Applied on the drawer root so both the
     sidebar and its contents react to a single class. */
  .sidebar-collapsed .sidebar-container {
    width: 5rem;
  }

  .sidebar-collapsed .menu-label,
  .sidebar-collapsed .section-title {
    display: none !important;
  }

  .sidebar-collapsed .sidebar-header > a {
    display: none;
  }

  .sidebar-collapsed #sidebar-toggle {
    transform: rotate(180deg);
  }

  .sidebar-collapsed .sidebar-header,
  .sidebar-collapsed .sidebar-user,
  .sidebar-collapsed .sidebar-link {
    justify-content: center;
  }

  .sidebar-collapsed nav > div + div {
    border-top: 1px solid var(--color-slate-200, #e2e8f0);
    padding-top: 0.75rem;
  }
</style>

<script>
  (() => {
    const STORAGE_KEY = "sidebar-collapsed";

    const isCollapsed = () => localStorage.getItem(STORAGE_KEY) === "true";

    const applyState = () => {
      const drawer = document.getElementById("app-drawer");
      if (!drawer) return;

      const collapsed = isCollapsed();
      drawer.classList.toggle("sidebar-collapsed", collapsed);

      const button = document.getElementById("sidebar-toggle");
      if (!button) return;

      const label = collapsed ? "Expandir menu" : "Recolher menu";
      button.setAttribute("title", label);
      button.setAttribute("aria-label", label);
      button.setAttribute("aria-expanded", collapsed ? "false" : "true");
    };

    // The click handler is delegated from the document and registered once per
    // page load. Attaching it to the button itself is not safe here: LiveView
    // patches the layout DOM, which drops any inline guard such as a dataset
    // flag and leads to the handler being bound more than once.
    if (!window.sidebarToggleBound) {
      window.sidebarToggleBound = true;

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element) || !target.closest("#sidebar-toggle")) return;

        localStorage.setItem(STORAGE_KEY, isCollapsed() ? "false" : "true");
        applyState();
      });

      window.addEventListener("phx:page-loading-stop", applyState);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", applyState);
    } else {
      applyState();
    }
  })();
</script>
