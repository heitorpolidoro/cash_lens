<div class="py-6 space-y-6">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b border-slate-200">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Dashboard Financeiro</h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Visão consolidada do mês corrente e evolução real dos últimos 12 meses
      </p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-xs font-bold px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
        {@summary_month}
      </span>
      <.link href={~p"/imports"} class="btn btn-outline btn-sm">
        <.icon name="hero-arrow-up-tray" class="size-4 mr-1" /> Importar Extrato
      </.link>
    </div>
  </div>
  
<!-- KPI Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div id="kpi-saldo-atual" class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Saldo Atual</span>
      <div class="text-2xl font-black text-blue-600 mt-2">{format_currency(@total_balance)}</div>
      <div class="text-xs text-slate-400 mt-1">Soma das contas ativas</div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">
        Receitas ({@summary_month})
      </span>
      <div class="text-2xl font-black text-emerald-600 mt-2">
        {format_currency(@monthly_income)}
      </div>
      <div class="text-xs text-slate-400 mt-1">Entradas do mês</div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <span class="text-xs font-bold uppercase tracking-wider text-rose-600">
        Despesas ({@summary_month})
      </span>
      <div class="text-2xl font-black text-rose-600 mt-2">
        {format_currency(@monthly_expenses)}
      </div>
      <div class="text-xs text-slate-400 mt-1">Saídas do mês</div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
        Balanço ({@summary_month})
      </span>
      <div class={[
        "text-2xl font-black mt-2",
        if(Decimal.negative?(@monthly_balance), do: "text-rose-600", else: "text-emerald-600")
      ]}>
        {format_currency(@monthly_balance)}
      </div>
      <div class="text-xs text-slate-400 mt-1">Resultado líquido do mês</div>
    </div>
  </div>
  
<!-- Evolução Financeira + Minhas Contas -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-500">
            Evolução Financeira Consolidada
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Histórico real, sem projeções</p>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600">
          Últimos 12 meses
        </span>
      </div>
      <div class="w-full h-80 pt-2">
        <canvas id="balanceChart" data-history={@chart_data}></canvas>
      </div>
      
<!--
        The same series the chart above draws, as exact figures. The chart
        answers "which way is this going"; the table answers "how much,
        in that month". Most recent month first, because that is the one
        being read.
      -->
      <div class="overflow-x-auto border-t border-slate-100 pt-4">
        <table id="monthly-balance-table" class="w-full text-sm">
          <thead>
            <tr class="text-xs font-black uppercase tracking-wider text-slate-500">
              <th class="text-left pb-2 font-black">Mês</th>
              <th class="text-right pb-2 font-black">Receitas</th>
              <th class="text-right pb-2 font-black">Despesas</th>
              <th class="text-right pb-2 font-black">Balanço</th>
              <th class="text-right pb-2 font-black">Saldo Final</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={item <- Enum.reverse(@historical)}
              class="border-t border-slate-100 hover:bg-slate-50"
            >
              <td class="py-2">
                <.link
                  navigate={~p"/months/#{item.year}/#{item.month}"}
                  class="font-bold text-slate-900 hover:underline"
                >
                  {month_label(item.month)} {item.year}
                </.link>
              </td>
              <td class="py-2 text-right text-emerald-600 tabular-nums">
                {format_currency(item.income)}
              </td>
              <td class="py-2 text-right text-rose-600 tabular-nums">
                {format_currency(item.expenses)}
              </td>
              <td class={[
                "py-2 text-right font-black tabular-nums",
                if(item.balance >= 0, do: "text-emerald-600", else: "text-rose-600")
              ]}>
                {format_currency(item.balance)}
              </td>
              <td class="py-2 text-right font-bold text-slate-900 tabular-nums">
                {format_currency(item.final_balance)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900 tracking-tight">Minhas Contas</h2>
          <p class="text-xs text-slate-400 mt-0.5">Saldo por instituição</p>
        </div>
        <.link navigate={~p"/accounts"} class="text-xs font-bold text-blue-600 hover:underline">
          Ver todas
        </.link>
      </div>

      <div class="space-y-3">
        <.link
          :for={account <- @accounts}
          navigate={~p"/transactions?account_id=#{account.id}&return_to=dashboard"}
          class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50/70 border border-slate-200 hover:bg-slate-100 transition gap-3"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-10 h-10 rounded-xl overflow-hidden flex-shrink-0 shadow-sm">
              <img
                :if={account.icon && account.icon != ""}
                src={account.icon}
                alt={account.name}
                class="w-full h-full object-cover"
              />
              <div
                :if={!(account.icon && account.icon != "")}
                class={[
                  "flex items-center justify-center h-full w-full font-bold text-white text-sm",
                  if(account.color, do: "bg-[#{account.color}]", else: "bg-blue-600")
                ]}
              >
                {String.slice(account.bank || account.name, 0..1)}
              </div>
            </div>
            <div class="min-w-0">
              <p class="font-bold text-sm text-slate-900 truncate">{account.name}</p>
              <p class="text-xs text-slate-500 truncate">{account.bank}</p>
            </div>
          </div>
          <p class="font-extrabold text-sm text-slate-900 whitespace-nowrap text-right">
            {format_currency(account.display_balance)}
          </p>
        </.link>

        <div
          :if={Enum.empty?(@accounts)}
          class="text-center py-4 text-slate-400 italic text-sm"
        >
          Nenhuma conta cadastrada.
        </div>
      </div>

      <div class="pt-3 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
        <span>Total em Contas</span>
        <span class="font-black text-slate-900 text-sm">{format_currency(@total_balance)}</span>
      </div>
    </div>
  </div>
</div>
