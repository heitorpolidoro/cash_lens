<div class="max-w-sm mx-auto mt-24 p-6 bg-white rounded-2xl border border-slate-200">
  <h1 class="text-xl font-bold mb-4">Criar conta</h1>

  <.form :let={f} for={@changeset} action={~p"/users/register"} as={:user}>
    <.input field={f[:email]} type="email" label="E-mail" required />
    <.input field={f[:password]} type="password" label="Senha (mínimo 12 caracteres)" required />
    <.button class="w-full mt-4">Registrar</.button>
  </.form>

  <p class="mt-4 text-sm">
    <.link href={~p"/users/log_in"} class="font-semibold">Já tenho conta</.link>
  </p>
</div>
