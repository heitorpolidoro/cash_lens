+  transaction).
+  """
+  @spec filter_temporary_entries([Entry.t()], %{Ecto.UUID.t() => Date.t()} | nil) :: [Entry.t()]
+  def filter_temporary_entries(entries, latest_dates_by_account_id \\ nil) do
+    latest_dates = latest_dates_by_account_id || Transactions.latest_transaction_dates()
+
+    Enum.filter(entries, fn entry ->
+      case Map.get(latest_dates, entry.account_id) do
+        nil -> true
+        latest_date -> Date.compare(entry.date, latest_date) == :gt
+      end
+    end)
+  end
